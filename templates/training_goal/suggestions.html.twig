{% extends 'base.html.twig' %}

{% block title %}Sugerowane ćwiczenia – FitTracker{% endblock %}

{% block body %}
    <div class="py-8 px-4 max-w-7xl mx-auto">

        {# Obsługa komunikatów Flash #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm flex items-center gap-3 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {% if goals is empty %}
            {# Brak aktywnych celów #}
            <div class="max-w-md mx-auto text-center py-16">
                <div class="inline-flex p-4 bg-blue-50 rounded-full text-blue-600 mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" class="text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Brak aktywnych celów</h1>
                <p class="text-gray-500 mb-6">Zdefiniuj swoje cele treningowe, aby system mógł zasugerować odpowiednie ćwiczenia.</p>
                <a href="{{ path('app_training_goal_set') }}" class="inline-flex items-center justify-center px-5 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium shadow-sm transition-colors">
                    Dodaj cel treningowy
                </a>
            </div>
        {% else %}
            {# Nagłówek strony #}
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
                <div>
                    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Sugerowane ćwiczenia</h1>
                    <p class="text-sm text-gray-500 mt-1">Lista ćwiczeń dopasowana automatycznie na podstawie Twoich aktywnych celów.</p>
                </div>
                <div class="flex-shrink-0">
                    <a href="{{ path('app_training_goal_set') }}" class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition-colors shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Dodaj kolejny cel
                    </a>
                </div>
            </div>

            {# Nowa, ładna sekcja z aktywnymi celami #}
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 mb-8">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-3">Twoje aktywne cele treningowe:</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for goal in goals %}
                        <div class="flex items-start justify-between p-4 rounded-xl bg-gradient-to-br from-blue-50/60 to-indigo-50/30 border border-blue-100 shadow-sm">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
                                    <h3 class="font-bold text-gray-900 text-sm sm:text-base leading-tight">{{ goal.goalType.getLabel() }}</h3>
                                </div>
                                {% if goal.notes %}
                                    <p class="text-xs text-gray-500 italic mt-1 line-clamp-2">"{{ goal.notes }}"</p>
                                {% endif %}
                            </div>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-600 text-white shadow-sm flex-shrink-0">
                                {% if goal.fitnessLevel == 1 %}Początkujący
                                {% elseif goal.fitnessLevel == 2 %}Średni
                                {% elseif goal.fitnessLevel == 3 %}Zaawansowany
                                {% else %}Poziom {{ goal.fitnessLevel }}
                                {% endif %}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Sekcja ćwiczeń #}
            {% if suggestions is empty %}
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-12 text-center max-w-2xl mx-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" class="mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h3 class="text-lg font-bold text-gray-900 mb-1">Brak sugerowanych ćwiczeń</h3>
                    <p class="text-sm text-gray-500">Dodaj ćwiczenia w bazie, oznaczając je odpowiednimi celami, lub dodaj cele wspierane przez Twoje ćwiczenia.</p>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for exercise in suggestions %}
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
                            <div>
                                <div class="flex items-start justify-between gap-2 mb-3">
                                    <h2 class="text-lg font-bold text-gray-900 leading-tight">{{ exercise.name }}</h2>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 capitalize">
                                        {{ exercise.type }}
                                    </span>
                                </div>

                                <div class="flex items-center gap-1 mb-3">
                                    <span class="text-xs text-gray-500 mr-1">Trudność:</span>
                                    <div class="flex text-amber-400">
                                        {% for i in 1..9 %}
                                            <svg width="16" height="16" class="w-4 h-4 {{ i <= exercise.difficulty ? 'fill-current' : 'text-gray-200 stroke-current' }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                        {% endfor %}
                                    </div>
                                    <span class="text-xs font-semibold text-gray-700 ml-1">({{ exercise.difficulty }}/9)</span>
                                </div>

                                {% if exercise.supportedGoals is not empty %}
                                    <div class="mb-4">
                                        <span class="text-xs text-gray-500 block mb-1">Dopasowane cele:</span>
                                        <div class="flex flex-wrap gap-1">
                                            {% for supportedGoal in exercise.supportedGoals %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-green-50 text-green-700 border border-green-100">
                                                    {{ supportedGoal.goalType.label }}
                                                </span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}

                                {% if exercise.exerciseMuscles is not empty %}
                                    <div class="mt-4 pt-4 border-t border-gray-100">
                                        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Zaangażowane mięśnie:</h3>
                                        <div class="flex flex-wrap gap-1.5">
                                            {% for em in exercise.exerciseMuscles %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                                    {{ em.Muscle.name }}
                                                    <span class="ml-1 text-[10px] text-blue-500 font-normal">
                                                        ({{ em.ActivationLevel.getLabel() }})
                                                    </span>
                                                </span>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}

    </div>
{% endblock %}
