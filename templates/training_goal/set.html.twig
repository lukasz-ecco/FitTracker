{% extends 'base.html.twig' %}

{% block title %}Ustaw cel treningowy – FitTracker{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto py-8 px-4">
        
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Twoje cele treningowe</h1>
            <p class="text-sm text-gray-500 mt-1">Zdefiniuj swoje cele, abyśmy mogli dopasować ćwiczenia do Twoich potrzeb.</p>
        </div>

        {# Informacja o aktualnych celach #}
        {% if activeGoals is not empty %}
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-8 shadow-sm">
                <h2 class="text-sm font-semibold text-blue-900 mb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                    </svg>
                    Aktualnie aktywne cele:
                </h2>
                <div class="space-y-3">
                    {% for goal in activeGoals %}
                        <div class="bg-white/80 border border-blue-100 rounded-lg p-3 text-sm">
                            <div class="flex items-center justify-between">
                                <span class="font-semibold text-blue-900">{{ goal.goalType.getLabel() }}</span>
                                <span class="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-medium">
                                    Poziom: 
                                    {% if goal.fitnessLevel == 1 %}Początkujący
                                    {% elseif goal.fitnessLevel == 2 %}Średniozaawansowany
                                    {% elseif goal.fitnessLevel == 3 %}Zaawansowany
                                    {% else %}{{ goal.fitnessLevel }}
                                    {% endif %}
                                </span>
                            </div>
                            {% if goal.notes %}
                                <p class="text-xs text-blue-600 mt-1.5 italic bg-blue-50/50 p-1.5 rounded">
                                    "{{ goal.notes }}"
                                </p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-5 mb-8 flex items-start gap-4 shadow-sm">
                <div class="p-2 bg-yellow-500 rounded-lg text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-sm font-semibold text-yellow-900">Brak ustawionych celów</h2>
                    <p class="text-sm text-yellow-700 mt-1">Nie masz jeszcze ustawionego żadnego celu treningowego. Wypełnij poniższy formularz, aby system mógł dopasować ćwiczenia.</p>
                </div>
            </div>
        {% endif %}

        {# Karta formularza #}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="mb-5">
                {{ form_label(form.goalType, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.goalType) }}
                {{ form_errors(form.goalType, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
            </div>

            <div class="mb-5">
                {{ form_label(form.fitnessLevel, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.fitnessLevel) }}
                {{ form_errors(form.fitnessLevel, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
            </div>

            <div class="mb-5">
                {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.notes) }}
                {{ form_errors(form.notes, {'attr': {'class': 'text-red-500 text-xs mt-1'}}) }}
            </div>

            <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-5">
                <a href="{{ path('app_training_goal_suggestions') }}" class="px-4 py-2 text-sm rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors font-medium">
                    Anuluj
                </a>
                <button type="submit" class="px-5 py-2 text-sm rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    Dodaj cel
                </button>
            </div>

            {{ form_end(form) }}
        </div>

    </div>
{% endblock %}
