{% extends 'base.html.twig' %}

{% block title %}Moi Trenerzy{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto py-8 px-4">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Moi Trenerzy</h1>
            <p class="text-sm text-gray-500 mt-1">Zarządzaj swoimi trenerami i otrzymanymi zaproszeniami.</p>
        </div>
    </div>

    {# Lista trenerów i zaproszeń #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Trener</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Akcje</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Trener główny</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for connection in connections %}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="text-sm font-medium text-gray-900">{{ connection.trainer.email }}</div>
                    </td>
                    <td class="px-6 py-4">
                        {% if connection.status == 'PENDING' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Oczekujące zaproszenie</span>
                        {% elseif connection.status == 'ACCEPTED' %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Aktywny</span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Odrzucone</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        {% if connection.status == 'PENDING' %}
                            <div class="flex gap-2">
                                <form action="{{ path('app_trainee_connection_status', {'id': connection.id}) }}" method="POST">
                                    <input type="hidden" name="status" value="ACCEPTED">
                                    <button type="submit" class="text-xs font-medium text-green-600 hover:text-green-800 bg-green-50 px-3 py-1.5 rounded-md hover:bg-green-100 transition-colors">Akceptuj</button>
                                </form>
                                <form action="{{ path('app_trainee_connection_status', {'id': connection.id}) }}" method="POST">
                                    <input type="hidden" name="status" value="REJECTED">
                                    <button type="submit" class="text-xs font-medium text-red-600 hover:text-red-800 bg-red-50 px-3 py-1.5 rounded-md hover:bg-red-100 transition-colors">Odrzuć</button>
                                </form>
                            </div>
                        {% elseif connection.status == 'ACCEPTED' %}
                            <form action="{{ path('app_trainee_connection_status', {'id': connection.id}) }}" method="POST">
                                <input type="hidden" name="status" value="REJECTED">
                                <button type="submit" class="text-xs font-medium text-red-600 hover:text-red-800">Zakończ współpracę</button>
                            </form>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        {% if connection.status == 'ACCEPTED' %}
                            {% if connection.isMain %}
                                <span class="inline-flex items-center text-xs font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded-md border border-blue-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Trener Główny
                                </span>
                            {% else %}
                                <form action="{{ path('app_trainee_connection_main', {'id': connection.id}) }}" method="POST">
                                    <button type="submit" class="text-xs font-medium text-gray-500 hover:text-blue-600 hover:underline">Ustaw jako głównego</button>
                                </form>
                            {% endif %}
                        {% else %}
                            <span class="text-gray-400 text-xs">-</span>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-12 text-center text-gray-400 text-sm">
                        Nie masz jeszcze przypisanego żadnego trenera ani oczekujących zaproszeń.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
