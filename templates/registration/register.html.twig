<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="UTF-8">
        <title>Zarejestruj się | Moja Aplikacja</title>
        {% block stylesheets %}
            {# Podpięcie skompilowanego pliku Tailwinda #}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
    </head>
    
    {# Kontener główny: pełny ekran, jasnoszare tło, wyśrodkowanie #}
    <body class="min-h-screen bg-gray-50 flex flex-col mt-5 items-center justify-center p-6 font-sans antialiased">
        
        {# Karta logowania: szerokość maks-md, białe tło, duże zaokrąglenia, cień #}
        <div class="w-full max-w-md bg-white -mt-50 p-10 rounded-3xl shadow-xl border border-gray-100">
            
            {# Nagłówki ( Title / Subtitle ) #}
            <h1 class="text-3xl font-extrabold text-center text-gray-900 tracking-tight">Dołącz do nas! 🚀</h1>
            <p class="text-center text-gray-600 mt-3 mb-8">Załóż darmowe konto</p>

            {# --- KOMUNIKATY O BŁĘDACH (np. przy weryfikacji email) --- #}
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
                    {{ flash_error }}
                </div>
            {% endfor %}

            {# --- GŁÓWNE BŁĘDY FORMULARZA --- #}
            {% if not registrationForm.vars.valid %}
                <div class="text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
                    Proszę poprawić błędy w formularzu poniżej.
                </div>
            {% endif %}

            {# Rozpoczęcie formularza z wyłączeniem domyślnej walidacji przeglądarki #}
            {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-6'}}) }}
                
                {# Pole Email #}
                <div>
                    {{ form_label(registrationForm.email) }}
                    {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'name@example.com'}}) }}
                    <div class="text-sm font-medium text-red-600 mt-1.5">
                        {{ form_errors(registrationForm.email) }}
                    </div>
                </div>

                {# Pole Hasło #}
                <div>
                    {{ form_label(registrationForm.plainPassword) }}
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': '••••••••'}}) }}
                    <div class="text-sm font-medium text-red-600 mt-1.5">
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>
                </div>

                {# Typ Konta #}
                <div>
                    {{ form_label(registrationForm.accountType) }}
                    <div class="flex items-center space-x-6 mt-2">
                        {% for child in registrationForm.accountType %}
                            <div class="flex items-center">
                                {{ form_widget(child, {'attr': {'class': 'h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500 cursor-pointer'}}) }}
                                {{ form_label(child, null, {'label_attr': {'class': 'ml-2 block text-sm text-gray-700 cursor-pointer mb-0'}}) }}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="text-sm font-medium text-red-600 mt-1.5">
                        {{ form_errors(registrationForm.accountType) }}
                    </div>
                </div>

                {# Checkbox - Akceptacja regulaminu #}
                <div>
                    <div class="flex items-center mt-4">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer'}}) }}
                        {{ form_label(registrationForm.agreeTerms, 'Akceptuję regulamin serwisu', {'label_attr': {'class': 'ml-2.5 block text-sm text-gray-700 cursor-pointer mb-0'}}) }}
                    </div>
                    <div class="text-sm font-medium text-red-600 mt-1.5">
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                </div>

                {# Przycisk logowania (Użycie klasy .btn-primary) #}
                <div class="pt-4">
                    <button type="submit" class="btn-primary w-full">
                        Zarejestruj się
                    </button>
                </div>
                
                {# Link: Zaloguj się (na samym dole) #}
                <div class="pt-6 border-t border-gray-100 mt-8 text-center text-sm text-gray-600">
                    Masz już konto? 
                    <a href="{{ path('app_login') }}" class="font-semibold text-blue-600 hover:text-blue-700 transition-colors">
                        Zaloguj się
                    </a>
                </div>
                
            {{ form_end(registrationForm) }}
            
        </div>
        
    </body>
</html>