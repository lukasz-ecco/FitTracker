{% extends 'base.html.twig' %}

{% block title %}Strona Główna{% endblock %}

{% block body %}
    <!-- Używamy klas z Bootstrap 5, żeby ładnie sformatować treść -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="card-title">Witaj, {{ controller_name }}! 👋</h1>
            <hr>
            <p class="card-text">To jest Twoja strona główna. Zauważ, że kod w tym pliku jest teraz bardzo krótki!</p>
            <p>Wszystko, co tu wpiszesz, wpadnie automatycznie wewnątrz bloku <code>.main-content</code> po prawej stronie, a pasek boczny zostanie nietknięty.</p>
            
            <button class="btn btn-primary mt-3">Przykładowy przycisk Bootstrap</button>
        </div>
    </div>
{% endblock %}