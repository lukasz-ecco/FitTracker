{# templates/security/login.html.twig #}

<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="UTF-8">
        <title>Zaloguj się | Moja Aplikacja</title>
        {% block stylesheets %}
            {# Podpięcie skompilowanego pliku Tailwinda #}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
    </head>
    
    {# Kontener główny: pełny ekran, jasnoszare tło, wyśrodkowanie #}
    <body class="min-h-screen bg-gray-50 flex flex-col mt-5 items-center justify-center p-6 font-sans antialiased">
        
        {# Karta logowania: szerokość maks-md, białe tło, duże zaokrąglenia, cień #}
        <div class="w-full max-w-md bg-white -mt-50 p-10 rounded-3xl shadow-xl border border-gray-100">
            
            {# Nagłówki ( Title / Subtitle ) #}
            <h1 class="text-3xl font-extrabold text-center text-gray-900 tracking-tight">Witaj ponownie! 👋</h1>
            <p class="text-center text-gray-600 mt-3 mb-8">Zaloguj się do swojego konta</p>

            <form action="{{ path('app_login') }}" method="post" class="space-y-6">
                {# --- NOWE: Komunikat o błędzie (jeśli np. podano złe hasło) --- #}
                {% if error %}
                    <div class="text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-xl p-4">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}
                {# Pole: Adres E-mail #}
                <div>
                    <label for="username" class="block text-sm font-semibold text-gray-700 mb-1.5">Adres e-mail</label>
                    {# Użycie klasy .form-input-styled z app.css #}
                    <input type="email" value="{{ last_username }}" name="email" id="username" class="form-input-styled" autocomplete="email" placeholder="email@przyklad.pl" required autofocus>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {# Pole: Hasło #}
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="password" class="block text-sm font-semibold text-gray-700">Hasło</label>
                        {# Opcjonalnie: Link do przypomnienia hasła (dodany Tailwindem) #}
                        <a href="#" class="text-xs font-medium text-blue-600 hover:text-blue-700 transition-colors">Zapomniałeś hasła?</a>
                    </div>
                    {# Użycie klasy .form-input-styled z app.css #}
                    <input type="password" name="password" id="password" class="form-input-styled" autocomplete="current-password" placeholder="••••••••" required>
                </div>

                {# Pole: Zapamiętaj mnie (Checkbox ostylowany Tailwindem) #}
                <div class="flex items-center">
                    <input type="checkbox" id="_remember_me" name="_remember_me" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer">
                    <label for="_remember_me" class="ml-2.5 block text-sm text-gray-700 cursor-pointer">
                        Zapamiętaj mnie na tym urządzeniu
                    </label>
                </div>

                {# Przycisk logowania (Użycie klasy .btn-primary) #}
                <div class="pt-4">
                    <button type="submit" class="btn-primary w-full">
                        Zaloguj się
                    </button>
                </div>

                {# Link: Zarejestruj się (na samym dole) #}
                <div class="pt-6 border-t border-gray-100 mt-8 text-center text-sm text-gray-600">
                    Nie masz konta? 
                    <a href="#" class="font-semibold text-blue-600 hover:text-blue-700 transition-colors">
                        Zarejestruj się
                    </a>
                </div>

            </form>
        </div>

    </body>
</html>