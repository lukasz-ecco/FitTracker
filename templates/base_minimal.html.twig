<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Zaloguj się{% endblock %}</title>
        <!-- Twój plik CSS -->
        {% block stylesheets %}
            {# Tutaj zazwyczaj ładuje się plik wygenerowany przez Tailwind #}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
        
        <style>
            /* Dodatkowy styl, żeby ładnie wyśrodkować formularze na tych stronach */
            body {
                background-color: #f4f6f9;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
                margin: 0;
            }
        </style>
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>