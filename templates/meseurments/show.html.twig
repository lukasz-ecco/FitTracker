{% extends 'base.html.twig' %}

{% block title %}Meseurments{% endblock %}

{% block body %}
    <h1>Meseurments</h1>
    <table class="table">
        <tbody>
        {% for each in meseurment %}
            <tr>
                <th>Id</th>
                <td>{{ each.id }}</td>
            </tr>
            <tr>
                <th>Size</th>
                <td>{{ each.Size }}</td>
            </tr>
            <tr>
                <th>Muscle</th>
                <td>{{ each.Muscle ? each.Muscle.name : '' }}</td>
            </tr>
            <tr>
                <th>User</th>
                <td>{{ each.User ? each.User.name : '' }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ each.date ? each.date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {# <a href="{{ path('app_meseurments_index') }}">back to list</a>

    <a href="{{ path('app_meseurments_edit', {'id': meseurment.id}) }}">edit</a> #}

    {# {{ include('meseurments/_delete_form.html.twig') }} #}
{% endblock %}
