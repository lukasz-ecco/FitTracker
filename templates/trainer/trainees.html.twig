{% extends 'base.html.twig' %}

{% block title %}Moi podopieczni
{% endblock %}

{% block body %}
	<div class="max-w-5xl mx-auto py-8 px-4">
		<div class="flex items-center justify-between mb-8">
			<div>
				<h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Moi podopieczni</h1>
				<p class="text-sm text-gray-500 mt-1">Zarządzaj swoimi podopiecznymi i wysyłaj zaproszenia.</p>
			</div>
		</div>

		{# Formularz zapraszania #}
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
			<h2 class="text-lg font-bold text-gray-900 mb-4">Zaproś nowego podopiecznego</h2>
			<form action="{{ path('app_trainer_invite') }}" method="POST" class="flex items-end gap-4">
				<div class="flex-1">
					<label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Adres e-mail podopiecznego</label>
					<input type="email" name="email" id="email" required placeholder="np. jan@kowalski.pl" class="border border-gray-300 rounded-xl px-4 py-3 bg-white w-full transition-all duration-150 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 outline-none shadow-inner">
				</div>
				<button type="submit" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
					Wyślij zaproszenie
				</button>
			</form>
		</div>

		{# Lista podopiecznych #}
		<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Podopieczny</th>
						<th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
						<th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Data zaproszenia</th>
						<th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Główny trener</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100">
					{% for connection in connections %}
						<tr class="hover:bg-gray-50 transition-colors">
							<td class="px-6 py-4">
								<div class="flex items-center">
									<div class="flex-shrink-0 h-10 w-10">
										<img class="h-10 w-10 rounded-full object-cover border border-gray-100 shadow-sm" src="{{ connection.trainee.profilePicture ? asset('uploads/avatars/' ~ connection.trainee.profilePicture) : 'https://ui-avatars.com/api/?name=' ~ connection.trainee.email|url_encode ~ '&background=random' }}" alt="Avatar">
									</div>
									<div class="ml-4">
										<div class="text-sm font-medium text-gray-900">
											{{ connection.trainee.name ? connection.trainee.name ~ ' ' ~ connection.trainee.surrname : connection.trainee.email }}
										</div>
										{% if connection.trainee.name %}
											<div class="text-xs text-gray-500">{{ connection.trainee.email }}</div>
										{% endif %}
									</div>
								</div>
							</td>
							<td class="px-6 py-4">
								{% if connection.status == 'PENDING' %}
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Oczekujące</span>
								{% elseif connection.status == 'ACCEPTED' %}
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Zaakceptowane</span>
								{% else %}
									<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Odrzucone</span>
								{% endif %}
							</td>
							<td class="px-6 py-4 text-sm text-gray-500">
								{{ connection.createdAt|date('Y-m-d H:i') }}
							</td>
							<td class="px-6 py-4">
								{% if connection.isMain %}
									<span class="inline-flex items-center text-xs font-medium text-blue-600">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewbox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
										</svg>
										Tak
									</span>
								{% else %}
									<span class="text-gray-400 text-xs">Nie</span>
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="px-6 py-12 text-center text-gray-400 text-sm">
								Brak przypisanych podopiecznych. Wyślij zaproszenie powyżej!
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
