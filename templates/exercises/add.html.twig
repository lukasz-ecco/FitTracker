{% extends 'base.html.twig' %}

{% block title %}Dodaj nowe ćwiczenie
{% endblock %}

{% block body %}
	<div class="max-w-2xl mx-auto py-8 px-4">

		<h1 class="text-2xl font-semibold text-gray-800 mb-6">Dodaj nowe ćwiczenie</h1>

		<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">

			{{ form_start(form) }}

			<div class="mb-5">
				{{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
				{{ form_widget(form.name, {'attr': {'class': 'block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 text-sm'}}) }}
				{{ form_errors(form.name) }}
			</div>

			<div class="mb-5">
				{{ form_label(form.difficulty, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
				{{ form_widget(form.difficulty, {'attr': {'class': 'block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 text-sm bg-white'}}) }}
				{{ form_errors(form.difficulty) }}
			</div>

			<div class="mb-5">
				{{ form_label(form.type, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
				{{ form_widget(form.type, {'attr': {'class': 'block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 text-sm bg-white'}}) }}
				{{ form_errors(form.type) }}
			</div>

			{% set prototypeHtml %}
				<div class="collection-item flex items-end gap-3 mb-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
					<div class="flex-1">
						{{ form_row(form.exerciseMuscles.vars.prototype.Muscle) }}
					</div>
					<div class="flex-1">
						{{ form_row(form.exerciseMuscles.vars.prototype.ActivationLevel) }}
					</div>
					<div class="pb-1">
						<button type="button" data-action="form-collection#removeCollectionElement" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Usuń">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
							</svg>
						</button>
					</div>
				</div>
			{% endset %}

			<div class="mb-5 border-t border-gray-200 pt-5" data-controller="form-collection" data-form-collection-prototype-value="{{ prototypeHtml|e('html_attr') }}">
				<h3 class="block text-sm font-medium text-gray-700 mb-2">Zaangażowane mięśnie</h3>
				
				<div data-form-collection-target="collectionContainer">
					{% for exerciseMuscleForm in form.exerciseMuscles %}
						<div class="collection-item flex items-end gap-3 mb-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
							<div class="flex-1">
								{{ form_row(exerciseMuscleForm.Muscle) }}
							</div>
							<div class="flex-1">
								{{ form_row(exerciseMuscleForm.ActivationLevel) }}
							</div>
							<div class="pb-1">
								<button type="button" data-action="form-collection#removeCollectionElement" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Usuń">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
									</svg>
								</button>
							</div>
						</div>
					{% endfor %}
				</div>

				<button type="button" data-action="form-collection#addCollectionElement" class="mt-2 inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium rounded-lg text-blue-600 border border-blue-200 hover:bg-blue-50 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
					</svg>
					Dodaj mięsień
				</button>
			</div>

			{% set goalPrototypeHtml %}
			<div class="collection-item flex items-end gap-3 mb-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
				<div class="flex-1">
					{{ form_row(form.supportedGoals.vars.prototype.goalType) }}
				</div>
				<div class="pb-1">
					<button type="button" data-action="form-collection#removeCollectionElement" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Usuń">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
						</svg>
					</button>
				</div>
			</div>
			{% endset %}

			<div class="mb-5 border-t border-gray-200 pt-5" data-controller="form-collection" data-form-collection-prototype-value="{{ goalPrototypeHtml|e('html_attr') }}">
				<h3 class="block text-sm font-medium text-gray-700 mb-2">Wspierane cele treningowe</h3>
				
				<div data-form-collection-target="collectionContainer">
					{% for goalForm in form.supportedGoals %}
						<div class="collection-item flex items-end gap-3 mb-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
							<div class="flex-1">
								{{ form_row(goalForm.goalType) }}
							</div>
							<div class="pb-1">
								<button type="button" data-action="form-collection#removeCollectionElement" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Usuń">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
									</svg>
								</button>
							</div>
						</div>
					{% endfor %}
				</div>

				<button type="button" data-action="form-collection#addCollectionElement" class="mt-2 inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium rounded-lg text-blue-600 border border-blue-200 hover:bg-blue-50 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
					</svg>
					Dodaj cel
				</button>
			</div>

			<div class="mt-6 flex justify-end gap-3">
				<a href="{{ path('app_exercises') }}" class="px-4 py-2 text-sm rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors font-medium">
					Anuluj
				</a>
				<button type="submit" class="px-5 py-2 text-sm rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors shadow-sm">
					Dodaj ćwiczenie
				</button>
			</div>

			{{ form_end(form) }}

		</div>
	</div>
{% endblock %}
