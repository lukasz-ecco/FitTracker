{% extends 'base.html.twig' %}

{% block title %}Dodaj nowe ćwiczenie{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Dodaj nowe ćwiczenie </h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.difficulty) }}
        {{ form_row(form.type) }}
        
        <button type="submit" class="btn btn-primary mt-3">Dodaj ćwiczenie</button>
    {{ form_end(form) }}

</div>
{% endblock %}
