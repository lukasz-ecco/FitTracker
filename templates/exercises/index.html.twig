{% extends 'base.html.twig' %}

{% block title %}Ćwiczenia{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-8 px-4">

    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-semibold text-gray-800">Lista ćwiczeń</h1>
        <a href="{{ path('app_exercises_new') }}"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Dodaj ćwiczenie
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Nazwa</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Typ</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Poziom trudności</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Zaangażowane mięśnie</th>
                    <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Akcje</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for exercise in exercises %}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 text-sm font-medium text-gray-900">
                        {{ exercise.name }}
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                            {{ exercise.type == 'Wielostawowe' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' }}">
                            {{ exercise.type }}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                        {% if exercise.difficulty == 1 %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                🟢 Początkujący
                            </span>
                        {% elseif exercise.difficulty == 2 %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                🟡 Średniozaawansowany
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                🔴 Zaawansowany
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1">
                            {% for exerciseMuscle in exercise.exerciseMuscles %}
                                {% set level = exerciseMuscle.ActivationLevel.value %}
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium uppercase tracking-wider border
                                    {{ level == 'high' ? 'bg-red-50 text-red-700 border-red-200' :
                                       level == 'medium' ? 'bg-orange-50 text-orange-700 border-orange-200' :
                                       'bg-green-50 text-green-700 border-green-200' }}"
                                    title="Aktywacja: {{ exerciseMuscle.ActivationLevel.label }}">
                                    {{ exerciseMuscle.Muscle.name }}
                                </span>
                            {% else %}
                                <span class="text-xs text-gray-400 italic">Brak przypisanych mięśni</span>
                            {% endfor %}
                        </div>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <a href="{{ path('app_exercises_edit', {'id': exercise.id}) }}"
                           class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium rounded-lg text-blue-600 border border-blue-200 hover:bg-blue-50 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Edytuj
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-gray-400 text-sm">
                        Brak ćwiczeń. <a href="{{ path('app_exercises_new') }}" class="text-blue-600 hover:underline">Dodaj pierwsze ćwiczenie</a>.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
