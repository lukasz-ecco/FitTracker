<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        <!-- Bootstrap 5 -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        
        {% block stylesheets %}
            <!-- Podpięcie Twojego własnego pliku CSS -->
            <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </head>
    <body>
        <div class="layout-container">
            <!-- Lewy pasek nawigacyjny -->
            <nav class="sidebar">
                <div class="sidebar-header">
                    Moja Aplikacja
                </div>
                
                <div class="sidebar-nav">
                    <a href="#" class="active">🏠 Strona Główna</a>
                    <a href="#">👤 Twój Profil</a>
                    
                    <!-- Element z rozwijanym menu -->
                    <a href="#notificationsSubmenu" data-bs-toggle="collapse" aria-expanded="false" class="dropdown-toggle">
                        <span>🔔 Powiadomienia</span>
                    </a>
                    <!-- Ukryte podmenu (id musi pasować do href wyżej) -->
                    <div class="collapse" id="notificationsSubmenu">
                        <ul class="submenu-list">
                            <li><a href="#">Wszystkie powiadomienia</a></li>
                            <li><a href="#">Nieprzeczytane</a></li>
                            <li><a href="#">Ustawienia alertów</a></li>
                        </ul>
                    </div>

                    <a href="#">⚙️ Ustawienia</a>
                </div>
                
                <div class="sidebar-nav" style="margin-top: auto;">
                    <a href="/logout" style="color: #e74c3c;">🚪 Wyloguj się</a>
                </div>
            </nav>

            <main class="main-content">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>