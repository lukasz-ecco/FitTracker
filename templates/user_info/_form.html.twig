{% block body %}
{# Ten div tworzy teraz szerszą, bardziej przestronną kartę. Formularz jest jego bezpośrednim dzieckiem, aby poprawnie obejmować obie kolumny. #}
<div class="max-w-4xl mx-auto bg-white p-10 rounded-3xl shadow-xl border border-gray-100 mt-10">
    
    {{ form_start(form, {'attr': {'class': 'flex gap-10 w-full'}}) }}
        
        {# LEWA KOLUMNA: Tytuł i Formularz #}
        <div class="flex-1 space-y-8">
            
            <h2 class="text-3xl font-extrabold text-gray-900 mb-8 border-b pb-4 tracking-tight">Edytuj swój profil</h2>

            <div class="space-y-6">
                {# Imię i Nazwisko #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_row(form.name, {
                            'label': 'Imię', 
                            'attr': {
                                'placeholder': 'Podaj imię'
                            }
                        }) }}
                    </div>
                    <div>
                        {{ form_row(form.surrname, {
                            'label': 'Nazwisko', 
                            'attr': {
                                'placeholder': 'Podaj nazwisko'
                            }
                        }) }}
                    </div>
                </div>

                {# Wiek i Płeć #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_row(form.age, {
                            'label': 'Wiek', 
                            'attr': {
                                'placeholder': 'Podaj wiek'
                            }
                        }) }}
                    </div>
                    <div>
                        {{ form_row(form.gender, {
                            'label': 'Płeć', 
                            'attr': {
                                'placeholder': 'Wybierz płeć'
                            }
                        }) }}
                    </div>
                </div>

                {# Wzrost i Waga #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_row(form.height, {
                            'label': 'Wzrost', 
                            'attr': {
                                'placeholder': 'Podaj wzrost'
                            }
                        }) }}
                    </div>
                    <div>
                        {{ form_row(form.weight, {
                            'label': 'Waga', 
                            'attr': {
                                'placeholder': 'Podaj wagę'
                            }
                        }) }}
                    </div>
                </div>

                {# Przycisk Zapisu #}
                <div class="pt-8 border-t border-gray-100 mt-10">
                    {{ form_row(form.save, {'label': 'Zapisz zmiany'}) }}
                </div>
            </div>
                
        </div>

        {# PRAWA KOLUMNA: Zdjęcie Profilowe #}
        <div class="w-64 flex flex-col items-center" data-controller="image-preview">
            
            {# Label zdjęcia (opcjonalnie, można usunąć dla czystszego widoku) #}
            <label class="block text-sm font-semibold text-gray-700 mb-4">Zdjęcie profilowe</label>
            
            {# Kontener dla zdjęcia i przycisku zmiany #}
            <div class="relative w-48 h-48">
                {# Podgląd zdjęcia. Upewnij się, że masz domyślny awatar w assets/images/default-avatar.png #}
                <img data-image-preview-target="preview" src="{{ user.profilePicture ? asset('uploads/avatars/' ~ user.profilePicture) : 'https://ui-avatars.com/api/?name=' ~ user.email|url_encode ~ '&background=random' }}" class="w-full h-full object-cover rounded-full shadow-lg border-4 border-gray-100">
                
                {# Ładny input zdjęcia: etykieta jako okrągły przycisk zmiany zdjęcia #}
                <label for="{{ form.profilePicture.vars.id }}" class="absolute bottom-1 right-1 bg-blue-600 hover:bg-blue-700 p-3 rounded-full text-white cursor-pointer shadow-md transition-colors">
                    {# Ikona aparatu #}
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3  3 0 016 0z"></path></svg>
                </label>
            </div>
            
            {# Ukryty prawdziwy input (używa ID generowanego przez Symfony) #}
            {{ form_widget(form.profilePicture, {'attr': {
                'class': 'sr-only',
                'data-image-preview-target': 'input',
                'data-action': 'change->image-preview#readURL'
            }}) }}
            <span class="text-xs text-gray-500 mt-2">Zmień zdjęcie</span>
            <div class="text-sm font-medium text-red-600 mt-1.5">
                {{ form_errors(form.profilePicture) }}
            </div>
        </div>
        
    {{ form_end(form) }}

</div>
{% endblock %}