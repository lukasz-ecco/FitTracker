{# Nadpisujemy domyślny wygląd rozwijanej listy (select) #}
{% block choice_widget_collapsed %}
	{% if multiple is defined and multiple %}
		{# Multi-select: custom dropdown z checkboxami #}
		<div
			x-data="{
				                open: false,
				                selected: [{% for choice in choices %}{% if choice.value in value %}'{{ choice.value }}',{% endif %}{% endfor %}],
				                options: [
				                    {% for choice in choices %}
				                        { value: '{{ choice.value }}', label: '{{ choice.label }}' },
				                    {% endfor %}
				                ],
				                toggle(val) {
				                    const idx = this.selected.indexOf(val);
				                    if (idx === -1) { this.selected.push(val); }
				                    else { this.selected.splice(idx, 1); }
				                },
				                isSelected(val) { return this.selected.includes(val); },
				                get selectedLabels() {
				                    return this.options.filter(o => this.selected.includes(o.value));
				                },
				                get summary() {
				                    if (this.selected.length === 0) return 'Wybierz cele...';
				                    if (this.selected.length <= 2) return this.selectedLabels.map(o => o.label).join(', ');
				                    return this.selectedLabels.slice(0, 2).map(o => o.label).join(', ') + ' +' + (this.selected.length - 2);
				                },
				                remove(val) {
				                    this.selected = this.selected.filter(v => v !== val);
				                }
				            }" class="relative w-full" @click.away="open = false">

			{# Ukryty select wielokrotnego wyboru, natywnie wspierany przez przeglądarkę. Zastępuje ukryte inputy. #}
            <select name="{{ full_name }}{% if multiple and '[]' not in full_name %}[]{% endif %}" id="{{ id }}" multiple="multiple" class="hidden" x-model="selected">
                {% for choice in choices %}
                    <option value="{{ choice.value }}">{{ choice.label }}</option>
                {% endfor %}
            </select>

			{# Przycisk otwierający #}
			<button type="button" @click="open = !open" class="border border-gray-300 rounded-xl px-4 py-3 bg-white w-full text-left transition-all duration-150 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 outline-none shadow-inner flex justify-between items-center cursor-pointer min-h-[48px]">
				<div class="flex flex-wrap gap-1.5 flex-1 items-center">
					<template x-if="selected.length === 0">
						<span class="text-gray-400">Wybierz cele...</span>
					</template>
					<template x-for="item in selectedLabels" :key="item.value">
						<span class="inline-flex items-center gap-1 bg-blue-100 text-blue-700 text-xs font-medium px-2.5 py-1 rounded-lg">
							<span x-text="item.label"></span>
							<button type="button" @click.stop="remove(item.value)" class="hover:text-blue-900 transition-colors">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</span>
					</template>
				</div>
				<svg :class="{'rotate-180': open}" class="w-5 h-5 text-gray-400 transition-transform duration-200 ml-2 shrink-0" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
				</svg>
			</button>

			{# Lista opcji z checkboxami #}
			<ul x-show="open" x-transition.opacity.duration.200ms style="display: none;" class="absolute z-10 mt-2 w-full bg-white border border-gray-100 rounded-xl shadow-xl py-2 max-h-60 overflow-auto">
				<template x-for="option in options" :key="option.value">
					<li @click="toggle(option.value)" class="px-4 py-2.5 text-sm hover:bg-blue-50 cursor-pointer transition-colors flex items-center gap-3" :class="{'bg-blue-50': isSelected(option.value)}">
						<div class="w-5 h-5 rounded border-2 flex items-center justify-center shrink-0 transition-colors" :class="isSelected(option.value) ? 'bg-blue-600 border-blue-600' : 'border-gray-300'">
							<svg x-show="isSelected(option.value)" class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
							</svg>
						</div>
						<span x-text="option.label" :class="isSelected(option.value) ? 'text-blue-700 font-medium' : 'text-gray-700'"></span>
					</li>
				</template>
			</ul>
		</div>
	{% else %}
		<div
			x-data="{
				            open: false,
				            selectedValue: '{{ value }}',
				            options: [
				                {% for choice in choices %}
				                    { value: '{{ choice.value }}', label: '{{ choice.label }}' },
				                {% endfor %}
				            ],
				            get selectedLabel() {
				                let option = this.options.find(o => o.value === this.selectedValue);
				                return option ? option.label : '{% if placeholder is defined and placeholder is not empty %}{{ placeholder }}{% else %}Wybierz...{% endif %}';
				            },
				            selectOption(val) {
				                this.selectedValue = val;
				                this.open = false;
				                $refs.realSelect.value = val;
				            }
				        }" class="relative w-full">

			{# Ukryty, prawdziwy select #}
			<select x-ref="realSelect" name="{{ full_name }}" id="{{ id }}" class="hidden">
				{% if placeholder is defined and placeholder is not empty %}
					<option value="">{{ placeholder }}</option>
				{% endif %}
				{% for choice in choices %}
					<option value="{{ choice.value }}" {% if choice.value == value %} selected="selected" {% endif %}>
						{{ choice.label }}
					</option>
				{% endfor %}
			</select>

			{# Wizualny Przycisk #}
			<button type="button" @click="open = !open" @click.away="open = false" class="border border-gray-300 rounded-xl px-4 py-3 bg-white w-full text-left transition-all duration-150 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 outline-none shadow-inner flex justify-between items-center cursor-pointer">
				<span x-text="selectedLabel" class="text-gray-700"></span>
				<svg :class="{'rotate-180': open}" class="w-5 h-5 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
				</svg>
			</button>

			{# Rozwijana Lista #}
			<ul x-show="open" x-transition.opacity.duration.200ms style="display: none;" class="absolute z-10 mt-2 w-full bg-white border border-gray-100 rounded-xl shadow-xl py-2 max-h-60 overflow-auto">

				<template x-for="option in options" :key="option.value">
					<li @click="selectOption(option.value)" class="px-5 py-2.5 text-sm hover:bg-blue-50 hover:text-blue-700 cursor-pointer transition-colors flex items-center justify-between" :class="{'bg-blue-50 text-blue-700 font-bold': selectedValue === option.value, 'text-gray-700': selectedValue !== option.value}">
						<span x-text="option.label"></span>
						<svg x-show="selectedValue === option.value" class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
					</li>
				</template>

			</ul>
		</div>
	{% endif %}
{% endblock %}

{# Nadpisujemy domyślny wygląd prostych inputów (text, number, etc.) #}

{% block form_widget_simple %}
	{# Ustalamy domyślne klasy Tailwinda dla wszystkich inputów #}
	{% set default_class = 'border border-gray-300 rounded-xl px-4 py-3 bg-white w-full transition-all duration-150 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 outline-none shadow-inner' %}

	{# Łączymy nasze bazowe klasy z ewentualnymi klasami przekazanymi w wywołaniu form_widget() #}
	{% set attr = attr|merge({'class': (attr.class|default('') ~ ' ' ~ default_class)|trim}) %}

	{# Renderujemy ostateczny input korzystając z wbudowanych funkcji Symfony do atrybutów #}
	{% set type = type|default('text') %}
	<input type="{{ type }}" {{ block('widget_attributes') }} {% if value is not empty %} value="{{ value }}" {% endif %}/>
{% endblock form_widget_simple %}

{# Nadpisujemy domyślny wygląd textarea #}
{% block textarea_widget %}
	{% set default_class = 'border border-gray-300 rounded-xl px-4 py-3 bg-white w-full transition-all duration-150 focus:border-blue-400 focus:ring-4 focus:ring-blue-100 outline-none shadow-inner resize-y' %}
	{% set attr = attr|merge({'class': (attr.class|default('') ~ ' ' ~ default_class)|trim}) %}
	<textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{% endblock textarea_widget %}

{# Nadpisujemy domyślny wygląd etykiet (label) #}
{% block form_label %}
	{% if label is not same as(false) %}
		{% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' block text-sm font-semibold text-gray-700 mb-1.5')|trim}) %}

		<label
			{% with { attr: label_attr } %} {{ block('attributes') }} {% endwith %}>
			{# Symfony domyślnie tłumaczy labele, zostawiamy ten mechanizm #}
			{{ translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain) }}
		</label>
	{% endif %}
{% endblock form_label %}

{# Nadpisujemy domyślny wygląd przycisku submit #}

{% block submit_widget %}
	{% set default_class = 'px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg transition-all duration-200 transform hover:-translate-y-0.5' %}
	{% set attr = attr|merge({'class': (attr.class|default('') ~ ' ' ~ default_class)|trim}) %}
	{% set type = type|default('submit') %}

	<button type="{{ type }}" {{ block('button_attributes') }}>
		{{ translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain) }}
	</button>
{% endblock submit_widget %}
